<section class="section">
  <div class="container">
    <div class="image-with-text{% if section.settings.layout == 'text_first' %} image-with-text--reverse{% endif %}">
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1100 | image_tag:
            loading: 'lazy',
            class: 'image-with-text__img',
            widths: '550, 825, 1100',
            sizes: '(min-width: 990px) 50vw, 100vw'
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'image-with-text__img placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="image-with-text__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Imagen con texto",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Nacidos para la aventura"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Somos riders. Probamos cada producto en la montaña, en el skatepark y en el mar antes de ponerlo en la tienda. Solo vendemos lo que usaríamos nosotros.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Conócenos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposición",
      "options": [
        { "value": "image_first", "label": "Imagen a la izquierda" },
        { "value": "text_first", "label": "Imagen a la derecha" }
      ],
      "default": "image_first"
    }
  ],
  "presets": [
    {
      "name": "Imagen con texto"
    }
  ]
}
{% endschema %}
