<section class="section">
  <div class="container">
    <h1 class="page-title">{{ blog.title }}</h1>

    {%- paginate blog.articles by 9 -%}
      <div class="grid grid--3col">
        {%- for article in blog.articles -%}
          <article class="article-card">
            <a href="{{ article.url }}" class="article-card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag:
                  loading: 'lazy',
                  class: 'article-card__img',
                  widths: '400, 600, 800',
                  sizes: '(min-width: 990px) 33vw, 100vw'
                }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'article-card__img placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="article-card__info">
              <time class="article-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d/%m/%Y' }}</time>
              <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
              <a href="{{ article.url }}" class="link-arrow">{{ 'blogs.article.read_more' | t }} {% render 'icon', icon: 'arrow-right', size: 16 %}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
