<section class="section">
  <div class="container container--xnarrow">
    <h1 class="page-title">{{ 'customer.activate.title' | t }}</h1>
    <p>{{ 'customer.activate.subtext' | t }}</p>

    {%- form 'activate_customer_password', class: 'account-form' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="ActivatePassword">{{ 'customer.activate.password' | t }}</label>
        <input class="field__input" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ActivatePasswordConfirm">{{ 'customer.activate.password_confirm' | t }}</label>
        <input class="field__input" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--lg btn--full">{{ 'customer.activate.submit' | t }}</button>
      <button type="submit" name="decline" class="btn btn--outline btn--full">{{ 'customer.activate.decline' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Activar cuenta",
  "settings": []
}
{% endschema %}
