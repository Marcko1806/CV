<section class="section">
  <div class="container container--xnarrow">
    <h1 class="page-title">{{ 'customer.reset.title' | t }}</h1>
    <p>{{ 'customer.reset.subtext' | t }}</p>

    {%- form 'reset_customer_password', class: 'account-form' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label for="ResetPassword">{{ 'customer.reset.password' | t }}</label>
        <input class="field__input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ResetPasswordConfirm">{{ 'customer.reset.password_confirm' | t }}</label>
        <input class="field__input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--lg btn--full">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Restablecer contraseña",
  "settings": []
}
{% endschema %}
