<section class="section">
  <div class="container container--narrow rich-text rich-text--{{ section.settings.alignment }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Texto enriquecido",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Cuenta tu historia"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Usa esta sección para hablar de tu marca, tus valores o cualquier novedad de la tienda.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Texto enriquecido"
    }
  ]
}
{% endschema %}
