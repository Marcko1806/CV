<div class="password-page">
  <div class="password-card">
    <p class="password-card__logo">{{ shop.name }}</p>
    <h1 class="password-card__heading">{{ 'general.password_page.opening_soon' | t }}</h1>

    {%- if shop.password_message != blank -%}
      <p class="password-card__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password-form' -%}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="Password">{{ 'general.password_page.password' | t }}</label>
      <div class="newsletter-form__row">
        <input type="password" name="password" id="Password" class="field__input" autocomplete="current-password" placeholder="{{ 'general.password_page.password' | t }}">
        <button type="submit" class="btn">{{ 'general.password_page.enter' | t }}</button>
      </div>
    {%- endform -%}

    <p class="password-card__admin">
      {{ 'general.password_page.admin_note' | t }}
      <a href="/admin">{{ 'general.password_page.admin_link' | t }}</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Página de contraseña",
  "settings": []
}
{% endschema %}
