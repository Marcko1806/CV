<section class="section">
  <div class="container">
    <div class="account-head">
      <h1 class="page-title">{{ 'customer.account.title' | t }}</h1>
      <a href="{{ routes.account_logout_url }}" class="link-arrow">{{ 'customer.account.log_out' | t }}</a>
    </div>

    <div class="account-grid">
      <div class="account-orders">
        <h2 class="account-subtitle">{{ 'customer.orders.title' | t }}</h2>

        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="table-wrap">
              <table class="account-table">
                <thead>
                  <tr>
                    <th>{{ 'customer.orders.order' | t }}</th>
                    <th>{{ 'customer.orders.date' | t }}</th>
                    <th>{{ 'customer.orders.payment_status' | t }}</th>
                    <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                    <th class="text-right">{{ 'customer.orders.total' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <td><a href="{{ order.customer_url }}" class="account-table__link">{{ order.name }}</a></td>
                      <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
                      <td>{{ order.financial_status_label }}</td>
                      <td>{{ order.fulfillment_status_label }}</td>
                      <td class="text-right">{{ order.total_price | money }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p>{{ 'customer.orders.none' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>

      <aside class="account-details">
        <h2 class="account-subtitle">{{ 'customer.account.details' | t }}</h2>
        <p>
          {{ customer.name }}<br>
          {{ customer.email }}
        </p>
        {%- if customer.default_address -%}
          <div class="account-address">{{ customer.default_address | format_address }}</div>
        {%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="btn btn--outline">{{ 'customer.account.view_addresses' | t: count: customer.addresses_count }}</a>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cuenta",
  "settings": []
}
{% endschema %}
