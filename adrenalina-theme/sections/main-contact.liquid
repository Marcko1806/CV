<section class="section">
  <div class="container container--narrow">
    <h1 class="page-title">{{ page.title }}</h1>
    {%- if page.content != blank -%}
      <div class="rte">{{ page.content }}</div>
    {%- endif -%}

    {%- form 'contact', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {{ form.errors | default_errors }}

      <div class="form-grid">
        <div class="field">
          <label for="ContactName">{{ 'contact.name' | t }}</label>
          <input class="field__input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{% if customer %}{{ customer.name }}{% endif %}">
        </div>
        <div class="field">
          <label for="ContactEmail">{{ 'contact.email' | t }}</label>
          <input class="field__input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{% if customer %}{{ customer.email }}{% endif %}">
        </div>
      </div>
      <div class="field">
        <label for="ContactBody">{{ 'contact.message' | t }}</label>
        <textarea class="field__input" id="ContactBody" rows="6" name="contact[body]" required></textarea>
      </div>
      <button type="submit" class="btn btn--lg">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contacto",
  "settings": []
}
{% endschema %}
