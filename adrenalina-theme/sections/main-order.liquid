<section class="section">
  <div class="container">
    <a href="{{ routes.account_url }}" class="link-arrow">&larr; {{ 'customer.account.return' | t }}</a>

    <h1 class="page-title">{{ 'customer.order.title' | t: name: order.name }}</h1>
    {%- assign order_date = order.created_at | date: '%d/%m/%Y' -%}
    <p class="order-meta">{{ 'customer.order.date' | t: date: order_date }}</p>

    {%- if order.cancelled -%}
      {%- assign cancelled_date = order.cancelled_at | date: '%d/%m/%Y' -%}
      <p class="form-error">{{ 'customer.order.cancelled' | t: date: cancelled_date }}</p>
    {%- endif -%}

    <div class="table-wrap">
      <table class="account-table">
        <thead>
          <tr>
            <th>{{ 'customer.order.product' | t }}</th>
            <th>{{ 'customer.order.price' | t }}</th>
            <th>{{ 'customer.order.quantity' | t }}</th>
            <th class="text-right">{{ 'customer.order.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>
                {%- if line_item.url != blank -%}
                  <a href="{{ line_item.url }}" class="account-table__link">{{ line_item.title }}</a>
                {%- else -%}
                  {{ line_item.title }}
                {%- endif -%}
              </td>
              <td>{{ line_item.final_price | money }}</td>
              <td>{{ line_item.quantity }}</td>
              <td class="text-right">{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3">{{ 'customer.order.subtotal' | t }}</td>
            <td class="text-right">{{ order.line_items_subtotal_price | money }}</td>
          </tr>
          {%- for shipping_method in order.shipping_methods -%}
            <tr>
              <td colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
              <td class="text-right">{{ shipping_method.price | money }}</td>
            </tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr>
              <td colspan="3">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
              <td class="text-right">{{ tax_line.price | money }}</td>
            </tr>
          {%- endfor -%}
          <tr class="account-table__total">
            <td colspan="3"><strong>{{ 'customer.order.total' | t }}</strong></td>
            <td class="text-right"><strong>{{ order.total_price | money }}</strong></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="order-addresses">
      <div>
        <h2 class="account-subtitle">{{ 'customer.order.billing_address' | t }}</h2>
        <p>{{ order.financial_status_label }}</p>
        {%- if order.billing_address -%}
          <div class="account-address">{{ order.billing_address | format_address }}</div>
        {%- endif -%}
      </div>
      <div>
        <h2 class="account-subtitle">{{ 'customer.order.shipping_address' | t }}</h2>
        <p>{{ order.fulfillment_status_label }}</p>
        {%- if order.shipping_address -%}
          <div class="account-address">{{ order.shipping_address | format_address }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pedido",
  "settings": []
}
{% endschema %}
