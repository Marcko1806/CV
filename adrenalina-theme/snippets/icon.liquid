{%- liquid
  assign icon_size = size | default: 24
-%}
<svg
  class="icon icon--{{ icon }}{% if class %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'menu' -%}
      <path d="M3 6h18M3 12h18M3 18h18"/>
    {%- when 'close' -%}
      <path d="M5 5l14 14M19 5L5 19"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/>
    {%- when 'cart' -%}
      <path d="M6 8h12l-1.2 13H7.2L6 8z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/>
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'trash' -%}
      <path d="M4 7h16M10 11v6M14 11v6M6 7l1 14h10l1-14M9 7V4h6v3"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h16M13 5l7 7-7 7"/>
    {%- when 'truck' -%}
      <path d="M1.5 6.5h12v10h-12zM13.5 10h4.5l3 3v3.5h-7.5"/><circle cx="6" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/>
    {%- when 'shield' -%}
      <path d="M12 3l8 3v6c0 4.8-3.4 7.9-8 9-4.6-1.1-8-4.2-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>
    {%- when 'refresh' -%}
      <path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"/><path d="M3 21v-5h5"/>
    {%- when 'chat' -%}
      <path d="M21 11.5c0 4.1-4 7.5-9 7.5-1 0-2-.1-2.9-.4L4 20l1.2-3.6C3.8 15.1 3 13.4 3 11.5 3 7.4 7 4 12 4s9 3.4 9 7.5z"/>
    {%- when 'star' -%}
      <path d="M12 3l2.7 5.8 6.3.8-4.6 4.3 1.2 6.1-5.6-3.1-5.6 3.1 1.2-6.1L3 9.6l6.3-.8L12 3z"/>
    {%- when 'check' -%}
      <path d="M4 12l5 5L20 7"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/>
    {%- when 'facebook' -%}
      <path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H8v3h3v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1z" fill="currentColor" stroke="none"/>
    {%- when 'youtube' -%}
      <rect x="2.5" y="6" width="19" height="12" rx="3"/><path d="M10 9.5l5 2.5-5 2.5z" fill="currentColor" stroke="none"/>
    {%- when 'tiktok' -%}
      <path d="M16.5 3c.4 2.1 1.8 3.6 4 3.9v3c-1.6 0-3-.5-4-1.3v6.4c0 3.3-2.7 6-6 6s-6-2.7-6-6 2.7-6 6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V3h3z" fill="currentColor" stroke="none"/>
    {%- when 'twitter' -%}
      <path d="M17.5 3h3l-7.1 8.1L21.7 21h-5.4l-4.2-5.5L7.3 21H4.2l7.6-8.7L2.8 3h5.5l3.8 5L17.5 3z" fill="currentColor" stroke="none"/>
  {%- endcase -%}
</svg>
