{%- assign sfx = id_suffix | default: 'new' -%}
<div class="form-grid">
  <div class="field">
    <label for="AddressFirstName-{{ sfx }}">{{ 'customer.addresses.first_name' | t }}</label>
    <input class="field__input" type="text" id="AddressFirstName-{{ sfx }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="field">
    <label for="AddressLastName-{{ sfx }}">{{ 'customer.addresses.last_name' | t }}</label>
    <input class="field__input" type="text" id="AddressLastName-{{ sfx }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
</div>
<div class="field">
  <label for="AddressCompany-{{ sfx }}">{{ 'customer.addresses.company' | t }}</label>
  <input class="field__input" type="text" id="AddressCompany-{{ sfx }}" name="address[company]" value="{{ form.company }}" autocomplete="organization">
</div>
<div class="field">
  <label for="AddressAddress1-{{ sfx }}">{{ 'customer.addresses.address1' | t }}</label>
  <input class="field__input" type="text" id="AddressAddress1-{{ sfx }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>
<div class="field">
  <label for="AddressAddress2-{{ sfx }}">{{ 'customer.addresses.address2' | t }}</label>
  <input class="field__input" type="text" id="AddressAddress2-{{ sfx }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="form-grid">
  <div class="field">
    <label for="AddressCity-{{ sfx }}">{{ 'customer.addresses.city' | t }}</label>
    <input class="field__input" type="text" id="AddressCity-{{ sfx }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
  </div>
  <div class="field">
    <label for="AddressZip-{{ sfx }}">{{ 'customer.addresses.zip' | t }}</label>
    <input class="field__input" type="text" id="AddressZip-{{ sfx }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
  </div>
</div>
<div class="field">
  <label for="AddressCountry-{{ sfx }}">{{ 'customer.addresses.country' | t }}</label>
  <select class="field__input" id="AddressCountry-{{ sfx }}" name="address[country]" data-country-select data-default="{{ form.country }}" autocomplete="country">
    {{ all_country_option_tags }}
  </select>
</div>
<div class="field" data-province-wrapper hidden>
  <label for="AddressProvince-{{ sfx }}">{{ 'customer.addresses.province' | t }}</label>
  <select class="field__input" id="AddressProvince-{{ sfx }}" name="address[province]" data-province-select data-default="{{ form.province }}" autocomplete="address-level1"></select>
</div>
<div class="field">
  <label for="AddressPhone-{{ sfx }}">{{ 'customer.addresses.phone' | t }}</label>
  <input class="field__input" type="tel" id="AddressPhone-{{ sfx }}" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>
<div class="field field--checkbox">
  {{ form.set_as_default_checkbox }}
  <label for="address_default_address_{{ form.id | default: 'new' }}">{{ 'customer.addresses.set_default' | t }}</label>
</div>
