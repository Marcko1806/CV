{%- if placeholder -%}
  <div class="product-card">
    <div class="product-card__media">
      {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'product-card__img placeholder-svg' }}
    </div>
    <div class="product-card__info">
      <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
      <div class="price"><span class="price__current">{{ 1999 | money }}</span></div>
    </div>
  </div>
{%- else -%}
  {%- liquid
    assign show_second = false
    if settings.card_hover_second_image and card_product.media.size > 1
      assign show_second = true
    endif
  -%}
  <div class="product-card">
    <a href="{{ card_product.url }}" class="product-card__media{% if show_second %} product-card__media--has-hover{% endif %}" aria-label="{{ card_product.title | escape }}">
      {%- if card_product.featured_media -%}
        {{ card_product.featured_media | image_url: width: 720 | image_tag:
          loading: 'lazy',
          class: 'product-card__img',
          widths: '360, 540, 720, 900',
          sizes: '(min-width: 990px) 25vw, 50vw'
        }}
        {%- if show_second -%}
          {{ card_product.media[1] | image_url: width: 720 | image_tag:
            loading: 'lazy',
            class: 'product-card__img product-card__img--hover'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__img placeholder-svg' }}
      {%- endif -%}

      {%- if card_product.compare_at_price > card_product.price -%}
        <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
      {%- elsif card_product.available == false -%}
        <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </a>
    <div class="product-card__info">
      {%- if settings.card_show_vendor and card_product.vendor != blank -%}
        <span class="product-card__vendor">{{ card_product.vendor }}</span>
      {%- endif -%}
      <h3 class="product-card__title">
        <a href="{{ card_product.url }}">{{ card_product.title }}</a>
      </h3>
      {% render 'price', product: card_product %}
    </div>
  </div>
{%- endif -%}
