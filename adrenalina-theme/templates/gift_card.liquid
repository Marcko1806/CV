{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.subtext' | t }} &middot; {{ shop.name }}</title>
    {{ content_for_header }}
    <style>
      body {
        margin: 0;
        font-family: system-ui, -apple-system, sans-serif;
        background: #0d0d10;
        color: #f5f5f5;
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 24px;
        box-sizing: border-box;
      }
      .gift-card {
        max-width: 420px;
        width: 100%;
        background: #16161a;
        border: 1px solid #2a2a30;
        border-radius: 16px;
        padding: 40px 28px;
      }
      .gift-card__shop {
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: 13px;
        color: #ff4d00;
        margin: 0 0 8px;
      }
      h1 { font-size: 22px; margin: 0 0 20px; }
      .gift-card__amount { font-size: 44px; font-weight: 800; margin: 0 0 20px; }
      .gift-card__code {
        font-family: ui-monospace, monospace;
        font-size: 20px;
        letter-spacing: 0.12em;
        background: #0d0d10;
        border: 1px dashed #4a4a52;
        border-radius: 8px;
        padding: 14px;
        margin: 0 0 20px;
      }
      .gift-card__meta { color: #a0a0a8; font-size: 14px; margin: 6px 0; }
      .gift-card__expired {
        display: inline-block;
        background: #ff4d00;
        color: #fff;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        border-radius: 999px;
        padding: 4px 12px;
        margin-bottom: 16px;
      }
      .gift-card__btn {
        display: inline-block;
        margin-top: 12px;
        background: #ff4d00;
        color: #fff;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        font-size: 14px;
        padding: 14px 28px;
        border-radius: 6px;
      }
    </style>
  </head>
  <body>
    <div class="gift-card">
      <p class="gift-card__shop">{{ shop.name }}</p>
      <h1>{{ 'gift_cards.issued.title' | t: shop: shop.name }}</h1>

      {%- if gift_card.expired or gift_card.enabled == false -%}
        <span class="gift-card__expired">{{ 'gift_cards.issued.expired' | t }}</span>
      {%- endif -%}

      <p class="gift-card__amount">{{ gift_card.initial_value | money }}</p>

      <p class="gift-card__meta">{{ 'gift_cards.issued.code' | t }}</p>
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>

      {%- if gift_card.balance != gift_card.initial_value -%}
        <p class="gift-card__meta">{{ 'gift_cards.issued.balance' | t }}: {{ gift_card.balance | money }}</p>
      {%- endif -%}

      {%- if gift_card.expires_on -%}
        {%- assign expiry_date = gift_card.expires_on | date: '%d/%m/%Y' -%}
        <p class="gift-card__meta">{{ 'gift_cards.issued.expires' | t: date: expiry_date }}</p>
      {%- endif -%}

      <a class="gift-card__btn" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t }}</a>
    </div>
  </body>
</html>
