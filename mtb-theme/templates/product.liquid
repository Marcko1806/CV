{% assign current_variant = product.selected_or_first_available_variant %}
{% assign on_sale = false %}
{% if product.compare_at_price > product.price %}{% assign on_sale = true %}{% endif %}

<div class="product-page">

  <!-- Gallery -->
  <div class="product-gallery">
    <div class="product-main-img" id="main-img">
      {% if product.featured_image %}
        <img id="main-img-tag"
          src="{{ product.featured_image | img_url: '800x800', crop: 'center' }}"
          alt="{{ product.title | escape }}">
      {% else %}
        <span style="font-size:8rem;">🚵</span>
      {% endif %}
    </div>

    {% if product.images.size > 1 %}
      <div class="product-thumbs">
        {% for image in product.images limit: 5 %}
          <div class="product-thumb{% if forloop.first %} active{% endif %}"
               data-src="{{ image | img_url: '800x800', crop: 'center' }}"
               onclick="selectImage(this)">
            <img src="{{ image | img_url: '120x120', crop: 'center' }}" alt="{{ image.alt | escape }}">
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!-- Details -->
  <div class="product-details">
    {% if product.type != blank %}
      <div class="product-category">{{ product.type }}</div>
    {% endif %}
    <h1>{{ product.title }}</h1>

    <span class="product-price" id="price">{{ current_variant.price | money }}</span>
    {% if on_sale %}
      <span class="compare-price">{{ product.compare_at_price | money }}</span>
    {% endif %}

    <hr class="product-divider">

    {% if product.description != blank %}
      <div class="product-description">{{ product.description }}</div>
    {% endif %}

    <!-- Variants -->
    {% unless product.has_only_default_variant %}
      {% for option in product.options_with_values %}
        <div class="variant-label">{{ option.name }}</div>
        <div class="variant-options" data-option-index="{{ forloop.index0 }}">
          {% for value in option.values %}
            <div class="variant-option{% if option.selected_value == value %} selected{% endif %}"
                 data-value="{{ value }}"
                 onclick="selectOption(this, {{ forloop.index0 }})">
              {{ value }}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    {% endunless %}

    <!-- Hidden variant selector -->
    <select id="variant-select" style="display:none;">
      {% for variant in product.variants %}
        <option value="{{ variant.id }}"
          {% if variant == current_variant %}selected{% endif %}
          {% unless variant.available %}disabled{% endunless %}
          data-price="{{ variant.price | money }}"
          data-available="{{ variant.available }}">
          {{ variant.title }}
        </option>
      {% endfor %}
    </select>

    <form id="add-to-cart-form">
      <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">
      <button type="submit" class="add-to-cart-big" id="atc-btn"
        {% unless current_variant.available %}disabled{% endunless %}>
        {% if current_variant.available %}Agregar al carrito{% else %}Agotado{% endif %}
      </button>
    </form>

    <div class="product-meta">
      SKU: <span>{{ current_variant.sku | default: 'N/A' }}</span> &nbsp;|&nbsp;
      Tipo: <span>{{ product.type | default: 'MTB' }}</span>
      {% if product.vendor != blank %}
        &nbsp;|&nbsp; Marca: <span>{{ product.vendor }}</span>
      {% endif %}
    </div>
  </div>
</div>

<!-- Related products -->
{% assign related = collections[product.collections.first.handle].products %}
{% if related.size > 1 %}
  <div class="section" style="border-top:1px solid #2a2a2a; margin-top:20px;">
    <h2 class="section-title">También te puede interesar</h2>
    <div class="products-grid">
      {% assign shown = 0 %}
      {% for p in related %}
        {% unless p.id == product.id %}
          {% if shown < 4 %}
            {% render 'product-card', product: p %}
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    </div>
  </div>
{% endif %}

<script>
  // ── Image gallery ──
  function selectImage(thumb) {
    document.getElementById('main-img-tag').src = thumb.dataset.src;
    document.querySelectorAll('.product-thumb').forEach(t => t.classList.remove('active'));
    thumb.classList.add('active');
  }

  // ── Variant selection ──
  const variantData = {{ product.variants | json }};
  let selectedOptions = [
    {% for option in product.options_with_values %}"{{ option.selected_value }}"{% unless forloop.last %},{% endunless %}{% endfor %}
  ];

  function selectOption(el, optionIndex) {
    el.closest('.variant-options').querySelectorAll('.variant-option').forEach(o => o.classList.remove('selected'));
    el.classList.add('selected');
    selectedOptions[optionIndex] = el.dataset.value;
    updateVariant();
  }

  function updateVariant() {
    const match = variantData.find(v =>
      v.options.every((opt, i) => opt === selectedOptions[i])
    );
    if (!match) return;

    document.getElementById('variant-id').value = match.id;
    document.getElementById('price').textContent = formatMoney(match.price);
    const btn = document.getElementById('atc-btn');
    btn.disabled = !match.available;
    btn.textContent = match.available ? 'Agregar al carrito' : 'Agotado';
  }

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  }

  // ── Add to cart form ──
  document.getElementById('add-to-cart-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('atc-btn');
    const id  = document.getElementById('variant-id').value;
    btn.disabled = true;
    btn.textContent = 'Agregando...';
    await window.MTB.addToCart(id, 1);
    btn.disabled = false;
    btn.textContent = 'Agregar al carrito';
  });
</script>
