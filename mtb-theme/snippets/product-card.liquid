{% comment %}
  Usage: {% render 'product-card', product: product %}
  Optional: badge (string), bg_gradient (CSS string)
{% endcomment %}

{% assign first_variant = product.selected_or_first_available_variant %}
{% assign on_sale = false %}
{% if product.compare_at_price > product.price %}
  {% assign on_sale = true %}
  {% assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
{% endif %}

<div class="product-card">
  <a href="{{ product.url }}" class="product-image" style="background: {{ bg_gradient | default: 'linear-gradient(135deg,#1a2a1a,#2d4a2d)' }};">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | img_url: '400x400', crop: 'center' }}" alt="{{ product.title | escape }}" loading="lazy">
    {% else %}
      <span class="product-image-placeholder">🚵</span>
    {% endif %}

    {% if badge %}
      <span class="product-badge badge-top">{{ badge }}</span>
    {% elsif product.metafields.custom.badge %}
      <span class="product-badge badge-top">{{ product.metafields.custom.badge }}</span>
    {% elsif on_sale %}
      <span class="product-badge badge-sale">-{{ discount_pct }}%</span>
    {% elsif product.created_at > 'now' | date: '%s' | minus: 2592000 | date: '%Y-%m-%dT%H:%M:%SZ' %}
      <span class="product-badge badge-new">Nuevo</span>
    {% endif %}
  </a>

  <div class="product-info">
    {% if product.type != blank %}
      <div class="product-category">{{ product.type }}</div>
    {% elsif product.collections.first %}
      <div class="product-category">{{ product.collections.first.title }}</div>
    {% endif %}

    <a href="{{ product.url }}" class="product-name">{{ product.title }}</a>

    {% if product.description != blank %}
      <p class="product-desc">{{ product.description | strip_html | truncate: 100 }}</p>
    {% endif %}

    <div class="product-footer">
      <div>
        <span class="product-price">{{ product.price | money }}</span>
        {% if on_sale %}
          <span class="product-price-old">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>

      {% if first_variant.available %}
        <button
          class="add-to-cart"
          data-variant-id="{{ first_variant.id }}"
          onclick="window.MTB.addToCart('{{ first_variant.id }}', 1, this)"
        >
          + Agregar
        </button>
      {% else %}
        <button class="add-to-cart" disabled>Agotado</button>
      {% endif %}
    </div>
  </div>
</div>
